# =============================================================================
# What Do You Want to Play? — configuration (.env)
# =============================================================================
# .env (next to docker-compose.yml) is the ONLY configuration file the
# application reads. Create it from this template (tutorial.md, section C):
#
#   cp .env.example .env && chmod 600 .env
#   nano .env                    fill in the REQUIRED values below
#
# Never commit .env (it is in .gitignore) and keep it private.
# Secrets: letters and digits only. Generate each one with: openssl rand -hex 24
#
# REQUIRED  = `docker compose up -d` refuses to start while it is empty.
# OPTIONAL  = has a sensible default; change only if you need to.
# =============================================================================

# --- 1. Your domain (REQUIRED) -------------------------------------------------
# The site's address as a full https URL with no trailing slash. Used for Steam
# sign-in (OpenID return address), secure cookies and cross-site request checks.
# Example: https://play.example.org
PUBLIC_BASE_URL=
# The same host name without https://. Not read by docker-compose.yml (its Traefik
# Host rule is written in the file); only ./scripts/check-env.sh checks it.
# Example: play.example.org
PUBLIC_HOSTNAME=

# --- 2. Traefik, your existing reverse proxy -------------------------------------
# The Traefik routing (host rule, entrypoint, certificate resolver, network name) is
# written directly in docker-compose.yml, on the frontend service (tutorial.md,
# section C; docs/adr/0023). The three values below are NOT read by
# docker-compose.yml; ./scripts/check-env.sh still checks TRAEFIK_NETWORK and
# TRAEFIK_CERT_RESOLVER, so keep them equal to what the Compose file uses.
TRAEFIK_NETWORK=
TRAEFIK_CERT_RESOLVER=
TRAEFIK_ENTRYPOINT=websecure
# REQUIRED. Addresses allowed to tell the backend the visitor's real IP
# (X-Forwarded-For), comma-separated CIDRs. The backend is reached through the
# frontend container, so include the stack's "edge" network AND Traefik's network:
#   docker network inspect <traefik-network> --format '{{(index .IPAM.Config 0).Subnet}}'
#   docker network inspect wdywtp_edge --format '{{(index .IPAM.Config 0).Subnet}}'
# (wdywtp_edge exists after the first `docker compose up -d`.)
# Example: 172.18.0.0/16,172.19.0.0/16
FORWARDED_ALLOW_IPS=

# --- 3. Secrets (REQUIRED) ------------------------------------------------------
# Four different random values: openssl rand -hex 24
# Set them BEFORE the first start: PostgreSQL stores the database passwords when it
# creates the database, so changing them later needs tutorial.md "Rotate secrets".
# PostgreSQL superuser: used only inside the database container and for backups.
POSTGRES_SUPERUSER_PASSWORD=
# Schema owner role: used only by database migrations.
DB_MIGRATION_PASSWORD=
# Runtime role: what the application uses (read/write data, no schema changes).
DB_PASSWORD=
# Redis password (Redis is never reachable from outside the server).
REDIS_PASSWORD=

# --- 4. Steam (REQUIRED for the main feature) ----------------------------------
# Steam Web API key of the site operator: https://steamcommunity.com/dev/apikey
# (needs a Steam account; enter your domain as the key's domain name).
# With it, a player's library and playtime are imported automatically after
# signing in with Steam. Without it the site falls back to manual game entry.
# Backend only; never sent to browsers. 32 hexadecimal characters.
STEAM_WEB_API_KEY=
# Store country for prices and availability (two letters).
STEAM_STORE_COUNTRY=US

# --- 5. Recommendation scoring mode (OPTIONAL, default TRUE) --------------------
# TRUE  = machine learning: collaborative filtering and the calibrated
#         satisfaction model rank recommendations once they are trained and pass
#         their quality gates (until then: classic scoring); daily training runs.
# FALSE = classic scoring only: a deterministic formula over the player's profile
#         and game features. No model is loaded and scheduled training is skipped;
#         behaviour data is still collected, and trained models are kept.
# Only TRUE or FALSE (any case). After changing it: docker compose up -d
AI_GRADE=TRUE

# --- 6. Optional data providers ---------------------------------------------------
# IGDB (game completion times). Enable only after reading and accepting IGDB's
# terms for your site. Needs a Twitch developer application (client id + secret).
IGDB_ENABLED=false
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Games whose current player counts are sampled every 2 hours for trends.
TREND_TRACKED_GAMES=400

# --- 7. Database names (OPTIONAL; set once, before the first start) -------------
# Changing these after the first start does NOT rename anything in the database.
POSTGRES_SUPERUSER=postgres
DB_NAME=wdywtp
DB_MIGRATION_USER=wdywtp_owner
DB_USER=wdywtp_app

# --- 8. Application (OPTIONAL) ----------------------------------------------------
# production on a server. (development is for workstations only.)
APP_ENV=production
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- 9. Capacity (OPTIONAL; DEPLOYMENT.md "Capacity") -----------------------------
# API processes (the backend container is limited to 2 CPUs).
WEB_CONCURRENCY=2
# Background jobs running in parallel in the worker.
WORKER_CONCURRENCY=3
# Web app keep-alive in milliseconds; keep it above Traefik's idle timeout (90 s).
FRONTEND_KEEPALIVE_MS=95000

# --- 10. Recommendation and model tuning (OPTIONAL) -----------------------------
# Players with this many ratings count as ready when there is no Steam key.
MIN_RATED_GAMES_FOR_PROFILE=5
# JSON object overriding scoring weights (docs/RECOMMENDATIONS.md), e.g.
# {"owned_backlog_weight": 0.2}. Empty = documented defaults.
RECOMMENDER_OVERRIDES=
# Collaborative model: trained only with at least this many players and
# positive interactions; weight of its score in Match once deployed.
CF_MIN_USERS=25
CF_MIN_POSITIVE_PAIRS=500
CF_BLEND_WEIGHT=0.3
# Satisfaction model: trained only with this many labels; must be calibrated
# within this error before "Predicted enjoyment" is shown.
SAT_MIN_LABELS=200
SAT_MAX_ECE=0.08

# --- 11. Sessions, rate limits, retention (OPTIONAL) ----------------------------
SESSION_IDLE_DAYS=14
API_RATE_LIMIT_PER_MINUTE_SESSION=600
API_RATE_LIMIT_PER_MINUTE_IP=300
EVENT_RETENTION_DAYS=730
# Database backups kept by ./scripts/backup-db.sh (newest N files).
BACKUP_KEEP=14

# --- Workstation development and tests only (not for a server) ------------------
# A workstation without Traefik can publish the app on localhost with the test
# overlay docker/dev/compose.dev.yaml (README.md, "Local development"). That
# overlay is not in this repository; these values are what it expects:
# APP_ENV=development
# PUBLIC_HOSTNAME=localhost
# PUBLIC_BASE_URL=http://localhost:3000
# TRAEFIK_NETWORK=wdywtp-local-proxy
# TRAEFIK_CERT_RESOLVER=none
# FORWARDED_ALLOW_IPS=127.0.0.1
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
